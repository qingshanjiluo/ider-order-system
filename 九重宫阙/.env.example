# 九重宫阙 环境配置（复制为 .env 后填写；.env 绝不入库）
NODE_ENV=development
PORT=3000

# 生产必须设置；缺失或为默认值时应用应拒绝以 production 启动
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SQLite 数据文件（默认 ./data/game.db）
DB_PATH=

# 备份目录（scripts/backup 使用）
BACKUP_DIR=./backups

# CORS 白名单（逗号分隔；留空=开发模式全放）
CORS_ORIGINS=

# AI 文案生成（可选，未配置则该功能自动降级）
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
