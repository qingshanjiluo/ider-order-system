# 九重宫阙 环境配置（复制为 .env 后填写；.env 绝不入库）
NODE_ENV=development
PORT=3000

# 生产必须设置；缺失或为默认值时应用应拒绝以 production 启动
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SQLite 数据目录（store 实际读的是 DSH_DATA_DIR，默认 ./data；DB_PATH 是历史死键，勿再依赖）

# 备份目录（scripts/backup 使用）
BACKUP_DIR=./backups

# CORS 白名单（逗号分隔；留空=开发模式全放）
CORS_ORIGINS=

# AI 后台运维令牌（X-Admin-Token 通道；生产环境必填，否则 AI 管理端点 503。
# 轮95 清理：旧 PROVIDER/API_KEY/MODEL 三键全仓无读取者=死键已除——
# LLM 密钥走后台「AI 后台」密钥池（轮91 合流，JWT is_admin 即可操作，运维头仅备用通道））
AI_ADMIN_TOKEN=
